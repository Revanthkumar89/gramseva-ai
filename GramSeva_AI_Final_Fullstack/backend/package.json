{
  "name": "gramseva-ai-backend",
  "version": "1.0.0",
  "description": "Backend API for GramSeva AI",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "build": "prisma generate",
    "db:deploy": "prisma generate && prisma db push && node prisma/seed.js",
    "start": "npm run db:deploy && node src/server.js",
    "server": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "create-admin": "node scripts/create-admin.js"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^6.0.0"
  }
}